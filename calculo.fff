^^I
^^I\subsection{Ejercicio B}
^^I
^^ISea la función:
^^I\[
^^If(x)=\sqrt{\frac{x+5}{x-1}}.
^^I\]
^^I
^^ICondición de existencia:
^^I\[
^^I\frac{x+5}{x-1}\geq 0,
^^I\qquad x-1\neq 0.
^^I\]
^^I
^^IPuntos críticos:
^^I\[
^^Ix+5=0 \Rightarrow x=-5,
^^I\qquad
^^Ix-1=0 \Rightarrow x=1.
^^I\]
^^I
^^IPor análisis de intervalos:
^^I\[
^^I\operatorname{Dom}(f)=(-\infty,-5]\cup(1,\infty).
^^I\]
^^I
^^IEl valor mínimo se obtiene en:
^^I\[
^^Ix=-5,
^^I\qquad
^^If(-5)=0.
^^I\]
^^I
^^IAdemás:
^^I\[
^^I\lim_{x\to\infty}\sqrt{\frac{x+5}{x-1}}=1.
^^I\]
^^I
^^IPor tanto:
^^I\[
^^I\operatorname{Rango}(f)=[0,1)\cup(1,\infty).
^^I\]
^^I
^^I\begin{figure}[H]
^^I^^I\centering
^^I^^I\begin{tikzpicture}
^^I^^I^^I\begin{axis}[
^^I^^I^^I^^Iwidth=13cm,
^^I^^I^^I^^Iheight=8cm,
^^I^^I^^I^^Igrid=both,
^^I^^I^^I^^Iaxis lines=middle,
^^I^^I^^I^^Ixlabel={$x$},
^^I^^I^^I^^Iylabel={$y$},
^^I^^I^^I^^Ititle={Gráfica de $f(x)=\sqrt{\frac{x+5}{x-1}}$},
^^I^^I^^I^^Isamples=200,
^^I^^I^^I^^Ixmin=-10, xmax=10,
^^I^^I^^I^^Iymin=0, ymax=8,
^^I^^I^^I^^Iunbounded coords=jump,
^^I^^I^^I^^I]
^^I^^I^^I^^I\addplot[teal, thick, domain=-10:-5] {sqrt(max(0,(x+5)/(x-1)))};
^^I^^I^^I^^I\addplot[teal, thick, domain=1.05:10] {sqrt(max(0,(x+5)/(x-1)))};
^^I^^I^^I^^I\addplot[dashed, red, thick] coordinates {(1,0) (1,8)};
^^I^^I^^I^^I\addplot[dashed, orange, thick] coordinates {(-10,1) (10,1)};
^^I^^I^^I^^I\addplot[only marks, mark=*, red, mark size=2.5pt] coordinates {(-5,0)};
^^I^^I^^I\end{axis}
^^I^^I\end{tikzpicture}
^^I^^I\caption{Gráfica de la función B.}
^^I\end{figure}
^^I
^^I\section{Función composición}
^^I
^^I\subsection{Ejercicio a}
^^I
^^I\[
^^If(x)=x-3,
^^I\qquad
^^Ig(x)=-x^2.
^^I\]
^^I
^^I\[
^^I(f\circ g)(x)=f(g(x))=-x^2-3.
^^I\]
^^I
^^I\[
^^I(g\circ f)(x)=g(f(x))=-(x-3)^2=-x^2+6x-9.
^^I\]
^^I
^^I\subsection{Ejercicio b}
^^I
^^I\[
^^If(x)=-x,
^^I\qquad
^^Ig(x)=x^2-x.
^^I\]
^^I
^^I\[
^^I(f\circ g)(x)=-(x^2-x)=-x^2+x.
^^I\]
^^I
^^I\[
^^I(g\circ f)(x)=(-x)^2-(-x)=x^2+x.
^^I\]
^^I
^^I\subsection{Ejercicio c}
^^I
^^I\[
^^If(x)=x^3-x^2+x,
^^I\qquad
^^Ig(x)=x-1.
^^I\]
^^I
^^I\[
^^I(f\circ g)(x)=f(x-1).
^^I\]
^^I
^^I\[
^^I(f\circ g)(x)=(x-1)^3-(x-1)^2+(x-1).
^^I\]
^^I
^^I\[
^^I(f\circ g)(x)=x^3-4x^2+6x-3.
^^I\]
^^I
^^I\[
^^I(g\circ f)(x)=g(f(x))=x^3-x^2+x-1.
^^I\]
^^I
^^I\subsection{Ejercicio d}
^^I
^^I\[
^^If(x)=\frac{x+1}{x-1},
^^I\qquad
^^Ig(x)=x^2-x.
^^I\]
^^I
^^I\[
^^I(f\circ g)(x)=\frac{g(x)+1}{g(x)-1}
^^I=\frac{x^2-x+1}{x^2-x-1}.
^^I\]
^^I
^^I\[
^^I(g\circ f)(x)=
^^I\left(\frac{x+1}{x-1}\right)^2
^^I-
^^I\left(\frac{x+1}{x-1}\right).
^^I\]
^^I
^^I\subsection{Ejercicio e}
^^I
^^I\[
^^If(x)=-\frac{1}{x^2},
^^I\qquad
^^Ig(x)=\frac{-x+2}{\sqrt{x}}.
^^I\]
^^I
^^I\[
^^I(f\circ g)(x)
^^I=
^^I-\frac{1}{\left(\frac{-x+2}{\sqrt{x}}\right)^2}.
^^I\]
^^I
^^I\[
^^I(f\circ g)(x)
^^I=
^^I-\frac{x}{(-x+2)^2}.
^^I\]
^^I
^^I\section{Límites por sustitución}
^^I
^^I\subsection{Ejercicio 24}
^^I
^^I\[
^^I\lim_{x\to 1}\frac{1}{3x-1}.
^^I\]
^^I
^^ISustituyendo:
^^I\[
^^I\frac{1}{3(1)-1}=\frac{1}{2}.
^^I\]
^^I
^^IPor tanto:
^^I\[
^^I\boxed{\lim_{x\to 1}\frac{1}{3x-1}=\frac{1}{2}}.
^^I\]
^^I
